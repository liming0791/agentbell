{
  "name": "agentbell",
  "version": "0.3.0-rc.2",
  "private": true,
  "description": "Cross-CLI Agent notifications delivered through Feishu's official lark-cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liming0791/agentbell.git"
  },
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:core": "node ./scripts/build-core.mjs",
    "check": "node ./scripts/check-structure.mjs",
    "ci": "npm run lint && npm run check && npm run test:coverage && npm run go:check && npm run pack:check",
    "doctor": "node ./packages/cli/bin/agentbell.mjs bootstrap-doctor",
    "go:check": "node ./scripts/check-go.mjs",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "npm pack --workspaces --dry-run",
    "perf:emit": "node ./scripts/benchmark-emit.mjs",
    "perf:m2": "npm run perf:emit && node ./scripts/benchmark-m2.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "setup:plan": "node ./packages/cli/bin/agentbell.mjs setup --plan",
    "smoke:bootstrap": "node ./scripts/smoke-bootstrap.mjs",
    "smoke:https": "node ./scripts/smoke-https-relay.mjs",
    "test": "node --test",
    "test:coverage": "node ./scripts/check-node-coverage.mjs",
    "test:migrations": "node ./scripts/check-migrations.mjs",
    "version:set": "node ./scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0"
  }
}
